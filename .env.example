NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quadrafort_survey
SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-a-separate-random-secret
ADMIN_EMAIL=
NOTIFY_ADMIN=false
EMAIL_FROM=Quantum Risk Readiness Survey <survey@quadrafort.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
EMAIL_VERIFICATION_ENABLED=false
DATA_RETENTION_DAYS=730
BACKUP_DIR=./backups
